# ==============================================================================
# Youth City — Root Environment Configuration (.env.example)
# Utilisé pour l'orchestration Docker Compose et la configuration globale
# ==============================================================================

# Copiez ce fichier en `.env` à la racine avant `docker compose up --build`.
# Backend Django & Sécurité
# OBLIGATOIRE : générez une clé (min. 32 caractères) puis collez-la ci-dessous :
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Laissée vide, Docker Compose refuse de démarrer (comportement voulu).
DJANGO_SECRET_KEY=
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend,frontend,youthcity.mg
CORS_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:80,http://localhost:5173

# Base de données PostgreSQL (production, OPS-07)
# OBLIGATOIRE : mot de passe sans caractère spécial d'URL, ex. : openssl rand -hex 24
# Laissé vide, Docker Compose refuse de démarrer (comportement voulu).
POSTGRES_PASSWORD=
POSTGRES_DB=youthcity
POSTGRES_USER=youthcity
# Jours de conservation des sauvegardes quotidiennes (OPS-03)
BACKUP_RETENTION_DAYS=7

# Sécurité HTTPS & Cookies (Production)
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SESSION_COOKIE_SECURE=False
DJANGO_CSRF_COOKIE_SECURE=False

# Frontend Web Client
VITE_API_URL=http://localhost:8000/api/v1
