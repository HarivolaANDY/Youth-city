# ============================================================
# Youth City — Variables d'Environnement de Production / Dev
# ============================================================

# Sécurité Django (OBLIGATOIRE EN PRODUCTION)
DJANGO_SECRET_KEY=change-me-to-a-secure-random-secret-key-in-production
DJANGO_DEBUG=False

# Hôtes autorisés (séparés par des virgules)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1],youthcity.mg

# CORS autorisés (séparés par des virgules)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://youthcity.mg

# Sécurité HTTPS & Cookies (activer en production)
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SESSION_COOKIE_SECURE=False
DJANGO_CSRF_COOKIE_SECURE=False
