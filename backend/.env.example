# ============================================================
# Youth City — Variables d'Environnement du Backend (développement local)
# Copiez ce fichier en `.env` : les valeurs ci-dessous fonctionnent telles quelles en dev.
# En production : DJANGO_DEBUG=False et une vraie clé secrète (voir commande ci-dessous).
# ============================================================

# Sécurité Django
# Générer une clé : python -c "import secrets; print(secrets.token_urlsafe(48))"
DJANGO_SECRET_KEY=dev-only-secret-key-do-not-use-in-production-0123456789
DJANGO_DEBUG=True

# Hôtes autorisés (séparés par des virgules)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1],youthcity.mg

# CORS autorisés (séparés par des virgules)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://[::1]:5173,https://youthcity.mg

# Sécurité HTTPS & Cookies (activer en production)
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SESSION_COOKIE_SECURE=False
DJANGO_CSRF_COOKIE_SECURE=False

# --- Mentor IA NOVA (optionnel) ---
# rules = conseils locaux (défaut) | anthropic = Claude (pip install -r requirements-ai.txt)
NOVA_AI_PROVIDER=rules
# Modèle utilisé si NOVA_AI_PROVIDER=anthropic (ex. claude-opus-5-5, claude-sonnet-5-5, claude-haiku-5-5 pour réduire le coût)
NOVA_AI_MODEL=claude-opus-5-5
# ANTHROPIC_API_KEY=...   (à définir côté serveur uniquement, jamais dans le frontend)
