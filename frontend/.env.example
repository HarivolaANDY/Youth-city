# ==============================================================================
# Youth City — Frontend Web Client Environment Configuration (.env.example)
# ==============================================================================

# URL de base de l'API Backend REST
# En mode développement local avec le proxy Vite, '/api' est utilisé par défaut.
# En déploiement autonome ou distant, spécifier l'URL complète (ex: http://localhost:8000/api ou https://api.youthcity.mg/api).
VITE_API_URL=/api
